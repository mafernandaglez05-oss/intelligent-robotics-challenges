<launch>

  <!-- ARGUMENTOS GLOBALES 
  def:"2,2;2,3;3,2;5,5;5,6;6,5;7,3;3,7"
  estrecho:"1,7;2,7;3,7;5,7;6,7;7,7;8,7;1,4;2,4;3,4;4,4;5,4;7,4;8,4"
  imposible:"3,6;4,6;5,6;3,5;5,5;3,4;4,4;5,4"-->
  <arg name="grid_size" default="10"/>
  <arg name="cell_size" default="0.50"/>
  <arg name="origin_x" default="0.5"/>
  <arg name="origin_y" default="0.5"/>
  <arg name="start_col" default="0"/>
  <arg name="start_row" default="0"/>
  <arg name="goal_col" default="4"/>
  <arg name="goal_row" default="5"/>
  <arg name="obstacles" default= "3,6;4,6;5,6;3,5;5,5;3,4;4,4;5,4"/>
  <arg name="draw_grid" default="true"/>

  <arg name="pkg" default="navigation_sim1_pkg"/>

  <node
    pkg="turtlesim"
    exec="turtlesim_node"
    name="turtlesim"
    output="screen"/>

  <node
    pkg="$(var pkg)"
    exec="odometry"
    name="odometry"
    output="screen">
    <param name="use_sim_time" value="false"/>
  </node>

  <node
    pkg="$(var pkg)"
    exec="controller"
    name="controller"
    output="screen">
    <param name="Kw" value="4.0"/>
    <param name="v_normal" value="0.5"/>
    <param name="v_slow" value="0.3"/>
    <param name="tolerance_dist" value="0.05"/>
    <param name="tolerance_angle" value="0.05"/>
  </node>

  <node
    pkg="$(var pkg)"
    exec="grid_visualizer"
    name="grid_visualizer"
    output="screen">
    <param name="grid_size" value="$(var grid_size)"/>
    <param name="cell_size" value="$(var cell_size)"/>
    <param name="origin_x" value="$(var origin_x)"/>
    <param name="origin_y" value="$(var origin_y)"/>
    <param name="start_col" value="$(var start_col)"/>
    <param name="start_row" value="$(var start_row)"/>
    <param name="goal_col" value="$(var goal_col)"/>
    <param name="goal_row" value="$(var goal_row)"/>
    <param name="obstacles" value="$(var obstacles)"/>
    <param name="draw_grid" value="$(var draw_grid)"/>
  </node>

</launch>
