<launch>
  <!-- ══════════════════════════════════════════════════════════════════════
       RRT Sampling Planner — Launch File  (ROS2 Humble)
       ══════════════════════════════════════════════════════════════════════
       Orden de arranque:
         1. turtlesim_node      — simulador
         2. odometry_node       — republica /turtle1/pose → /odom (Pose2D)
         3. controller          — FSM stop→align→move, suscribe /goals
         4. rrt_visualizer      — dibuja obstáculos, start, goal, árbol y path
         5. rrt_planner_node    — construye RRT, publica waypoints y viz data

       PARÁMETROS GLOBALES: cambia aquí y se propagan a todos los nodos.
       ══════════════════════════════════════════════════════════════════════ -->

  <!-- ── Caso por defecto: 4 obstáculos dispersos ──────────────────────── -->
  <arg name="start_x"     default="1.0"/>
  <arg name="start_y"     default="1.0"/>
  <arg name="goal_x"      default="9.0"/>
  <arg name="goal_y"      default="9.0"/>
  <arg name="goal_radius" default="0.4"/>
  <arg name="max_iter"    default="3000"/>
  <arg name="step_size"   default="0.5"/>
  <arg name="world_min"   default="0.5"/>
  <arg name="world_max"   default="10.5"/>
  <arg name="goal_bias"   default="0.15"/>
  <arg name="obstacles"
       default="3.0,3.0,0.8;6.0,4.0,0.8;4.0,7.0,0.8;7.0,7.5,0.8"/>

  <!-- ══════════════════════════════════════════════════════════════════════
       CAMBIA ESTE VALOR por el nombre real de tu paquete ROS2
       ══════════════════════════════════════════════════════════════════════ -->
  <arg name="pkg" default="retomike"/>

  <!-- ── 1. TurtleSim ───────────────────────────────────────────────────── -->
  <node
    pkg="turtlesim"
    exec="turtlesim_node"
    name="turtlesim"
    output="screen"
  />

  <!-- ── 2. Odometría ───────────────────────────────────────────────────── -->
  <node
    pkg="$(var pkg)"
    exec="odometry"
    name="odometry_node"
    output="screen"
  />

  <!-- ── 3. Controlador ─────────────────────────────────────────────────── -->
  <node
    pkg="$(var pkg)"
    exec="controller"
    name="controller"
    output="screen"
  >
    <param name="Kw"              value="4.0"/>
    <param name="v_normal"        value="0.2"/>
    <param name="tolerance_dist"  value="0.05"/>
    <param name="tolerance_angle" value="0.05"/>
  </node>

  <!-- ── 4. Visualizador RRT ────────────────────────────────────────────── -->
  <!-- Dibuja el mapa base (obstáculos, start, goal) al arrancar.           -->
  <!-- Luego espera /rrt/tree_edges y /rrt/path del planner para dibujar    -->
  <!-- el árbol (verde) y el camino final (cyan).                           -->
  <node
    pkg="$(var pkg)"
    exec="rrt_visualizer"
    name="rrt_visualizer"
    output="screen"
  >
    <param name="start_x"   value="$(var start_x)"/>
    <param name="start_y"   value="$(var start_y)"/>
    <param name="goal_x"    value="$(var goal_x)"/>
    <param name="goal_y"    value="$(var goal_y)"/>
    <param name="world_min" value="$(var world_min)"/>
    <param name="world_max" value="$(var world_max)"/>
    <param name="obstacles" value="$(var obstacles)"/>
  </node>

  

</launch>
