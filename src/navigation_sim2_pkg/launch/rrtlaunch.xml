<launch>


  <!-- def 4 obstáculos -->
  <arg name="start_x"     default="1.0"/>
  <arg name="start_y"     default="1.0"/>
  <arg name="goal_x"      default="9.0"/>
  <arg name="goal_y"      default="9.0"/>
  <arg name="goal_radius" default="0.4"/>
  <arg name="max_iter"    default="3000"/>
  <arg name="step_size"   default="0.5"/>
  <arg name="world_min"   default="0.5"/>
  <arg name="world_max"   default="10.5"/>
  <arg name="goal_bias"   default="0.15"/>
  <arg name="obstacles"
       default="3.0,3.0,0.8;6.0,4.0,0.8;4.0,7.0,0.8;7.0,7.5,0.8"/>

 
  <arg name="pkg" default="retomike"/>


  <node
    pkg="turtlesim"
    exec="turtlesim_node"
    name="turtlesim"
    output="screen"
  />


  <node
    pkg="$(var pkg)"
    exec="odometry"
    name="odometry_node"
    output="screen"
  />


  <node
    pkg="$(var pkg)"
    exec="controller"
    name="controller"
    output="screen"
  >
    <param name="Kw"              value="4.0"/>
    <param name="v_normal"        value="0.2"/>
    <param name="tolerance_dist"  value="0.05"/>
    <param name="tolerance_angle" value="0.05"/>
  </node>

  
  <node
    pkg="$(var pkg)"
    exec="rrt_visualizer"
    name="rrt_visualizer"
    output="screen"
  >
    <param name="start_x"   value="$(var start_x)"/>
    <param name="start_y"   value="$(var start_y)"/>
    <param name="goal_x"    value="$(var goal_x)"/>
    <param name="goal_y"    value="$(var goal_y)"/>
    <param name="world_min" value="$(var world_min)"/>
    <param name="world_max" value="$(var world_max)"/>
    <param name="obstacles" value="$(var obstacles)"/>
  </node>

  

</launch>
